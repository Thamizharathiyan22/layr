// Cloudflare Workers settings for Layr.
// Layr is a static site: Cloudflare only serves the built files in ./dist (free and unlimited).
{
  "name": "layr",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths like /privacy return index.html, and the app shows the right page
    "not_found_handling": "single-page-application"
  },
  // Only serve the site on layrphoto.com — turn off the extra *.workers.dev test addresses
  "workers_dev": false,
  "preview_urls": false
}
